{
  "name": "skilldock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/validate-skills.mjs && node scripts/check-private-files.mjs",
    "dev": "vite",
    "prebuild": "node scripts/validate-skills.mjs && node scripts/check-private-files.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "vault:init": "node scripts/pack-private-vault.mjs --init",
    "vault:pack": "node scripts/pack-private-vault.mjs",
    "test:vault": "node --test tests/private-vault.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "0.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
